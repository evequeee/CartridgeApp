<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CartridgeApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CartridgeApp"
    xmlns:views="clr-namespace:CartridgeApp.Views"
    Title="CARTRIDGE // XMB"
    Shell.BackgroundColor="{StaticResource XmbBackground}"
    Shell.TitleColor="{StaticResource XmbText}"
    Shell.ForegroundColor="{StaticResource XmbAccent}"
    Shell.UnselectedColor="{StaticResource XmbMuted}"
    Shell.NavBarHasShadow="False"
    Shell.TabBarBackgroundColor="{StaticResource XmbBackground}"
    Shell.TabBarForegroundColor="{StaticResource XmbAccent}"
    Shell.TabBarTitleColor="{StaticResource XmbAccent}"
    Shell.TabBarUnselectedColor="{StaticResource XmbMuted}">

    <TabBar>
        <ShellContent
            Title="LIBRARY"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
        <ShellContent
            Title="JOURNAL"
            ContentTemplate="{DataTemplate views:JournalPage}"
            Route="JournalPage" />
        <ShellContent
            Title="PROFILE"
            ContentTemplate="{DataTemplate views:ProfilePage}"
            Route="ProfilePage" />
        <ShellContent
            Title="ANALYTICS"
            ContentTemplate="{DataTemplate views:StatsPage}"
            Route="StatsPage" />
    </TabBar>

</Shell>