<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CartridgeApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CartridgeApp"
    xmlns:views="clr-namespace:CartridgeApp.Views"
    Title="CARTRIDGE // XMB"
    Shell.BackgroundColor="#060D1F"
    Shell.TitleColor="#F3F7FF"
    Shell.ForegroundColor="#00A8FF"
    Shell.TabBarBackgroundColor="#060D1F"
    Shell.TabBarTitleColor="#00A8FF"
    Shell.TabBarUnselectedColor="#6E85AD">

    <TabBar>
        <ShellContent
            Title="LIBRARY"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
        <ShellContent
            Title="STATISTICS"
            ContentTemplate="{DataTemplate views:StatsPage}"
            Route="StatsPage" />
    </TabBar>

</Shell>
