<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CartridgeApp.ViewModels"
             xmlns:models="clr-namespace:CartridgeApp.Models"
             xmlns:converters="clr-namespace:CartridgeApp.Converters"
             x:Class="CartridgeApp.MainPage"
             x:DataType="viewmodels:MainViewModel">

    <ContentPage.Resources>
        <converters:StatusColorConverter x:Key="StatusColorConverter" />
        <converters:RatingToStarsConverter x:Key="RatingToStarsConverter" />
    </ContentPage.Resources>

    <VerticalStackLayout Padding="20" Spacing="15" MaximumWidthRequest="1100" BackgroundColor="#060D1F">
        
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="12">
            <Label Text="Cartridge Roulette" FontSize="28" FontAttributes="Bold" />
            <Label Text="{Binding BacklogCount, StringFormat='Беклог: {0}'}" FontSize="16" VerticalOptions="Center" TextColor="DarkOrange" />
        </HorizontalStackLayout>
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                   IsVisible="{Binding IsBusy}"
                   Color="DarkOrange"
                   HorizontalOptions="Center" />

        <Button Text="🎲 Spin the Backlog!" 
                Command="{Binding SpinCommand}" 
                HorizontalOptions="Center" 
                Padding="20,10" 
                BackgroundColor="DarkOrange"
                TextColor="White"
                FontAttributes="Bold" />
        
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="15" Margin="0,0,0,10">
            <Button Text="+ Add Game" Command="{Binding AddGameCommand}" />
            <Button Text="Clear All" Command="{Binding ClearAllCommand}" BackgroundColor="IndianRed" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="10">
            <HorizontalStackLayout Spacing="10">
                <SearchBar Placeholder="Search games..."
                       Text="{Binding SearchQuery}"
                       HorizontalOptions="Fill" />
                <Picker Title="Sort by"
                    ItemsSource="{Binding SortOptions}"
                    SelectedItem="{Binding SelectedSortOption}"
                    WidthRequest="140" />
                <Picker Title="Status"
                    ItemsSource="{Binding StatusOptions}"
                    SelectedItem="{Binding SelectedStatusFilter}"
                    WidthRequest="140" />
            </HorizontalStackLayout>
        </HorizontalStackLayout>

        <CollectionView ItemsSource="{Binding FilteredGames}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="30" Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="Ігор не знайдено" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <Label Text="Спробуйте змінити пошук або фільтри." HorizontalTextAlignment="Center" TextColor="Gray" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Game">
                    <SwipeView>
                        <SwipeView.LeftItems>
                            <SwipeItems>
                                <SwipeItem Text="Favorite" 
                                           BackgroundColor="Gold"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=ToggleFavoriteCommand}"
                                           CommandParameter="{Binding .}" />
                                <SwipeItem Text="Edit"
                                           BackgroundColor="DodgerBlue"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=EditGameCommand}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.LeftItems>

                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete" 
                                           BackgroundColor="Red"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=RemoveGameCommand}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border Margin="0,8" Padding="15" Stroke="#264785" StrokeThickness="1" StrokeShape="RoundRectangle 12"
                                Background="#101D38">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=QuickChangeStatusCommand}"
                                                       CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" TextColor="Black" />
                                        <Label Text="⭐" FontSize="16" IsVisible="{Binding IsFavorite}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="{Binding Developer}" FontSize="14" TextColor="#333333" />
                                        <Label Text="|" FontSize="14" TextColor="Gray" />
                                        <Label Text="{Binding Platform}" FontSize="14" FontAttributes="Italic" TextColor="Gray" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding HoursPlayed, StringFormat='{}{0} год. зіграно'}" FontSize="13" TextColor="#555555" />
                                    <Label Text="{Binding Rating, Converter={StaticResource RatingToStarsConverter}}" FontSize="13" TextColor="Goldenrod" />
                                </VerticalStackLayout>
                                
                                <Border Grid.Column="1"
                                        Background="#080F22"
                                        Padding="8,5"
                                        Stroke="#264785"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 6"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding Status}" 
                                           FontSize="12" 
                                           FontAttributes="Bold" 
                                           TextColor="#F3F7FF" />
                                </Border>
                            </Grid>
                        </Border>
                        
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>