<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CartridgeApp.ViewModels"
             xmlns:converters="clr-namespace:CartridgeApp.Converters"
             x:Class="CartridgeApp.MainPage"
             x:DataType="viewmodels:MainViewModel">

    <ContentPage.Resources>
        <converters:StatusColorConverter x:Key="StatusColorConverter" />
    </ContentPage.Resources>

    <VerticalStackLayout Padding="20" Spacing="15">
        
        <Label Text="Cartridge Roulette" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" />
        <Button Text="Spin the Cylinder!" Command="{Binding SpinCommand}" HorizontalOptions="Center" Padding="20,10" />
        
        <Button Text="+ Add Game" Command="{Binding AddGameCommand}" HorizontalOptions="Center" Margin="0,0,0,10" />

        <CollectionView ItemsSource="{Binding Games}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.LeftItems>
                            <SwipeItems>
                                <SwipeItem Text="Favorite" 
                                           BackgroundColor="Gold"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=ToggleFavoriteCommand}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.LeftItems>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete" 
                                           BackgroundColor="Red"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=RemoveGameCommand}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Frame Margin="0,8" Padding="15" CornerRadius="10"
                               BackgroundColor="{Binding Status, Converter={StaticResource StatusColorConverter}}">
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                    
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" TextColor="Black" />
                                        <Label Text="⭐" FontSize="16" IsVisible="{Binding IsFavorite}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="{Binding Developer}" FontSize="14" TextColor="#333333" />
                                        <Label Text="|" FontSize="14" TextColor="Gray" />
                                        <Label Text="{Binding Platform}" FontSize="14" FontAttributes="Italic" TextColor="Gray" />
                                    </HorizontalStackLayout>
                                    
                                </VerticalStackLayout>
                                
                                <Frame Grid.Column="1" 
                                       BackgroundColor="{AppThemeBinding Light=White, Dark=#333333}" 
                                       Padding="8,5" 
                                       CornerRadius="5" 
                                       HasShadow="False" 
                                       VerticalOptions="Center">
                                    <Label Text="{Binding Status}" 
                                           FontSize="12" 
                                           FontAttributes="Bold" 
                                           TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                </Frame>
                            </Grid>
                        </Frame>
                        
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>