<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- ===== Legacy template colors (kept so nothing else breaks) ===== -->
    <Color x:Key="Primary">#0072CE</Color>
    <Color x:Key="PrimaryDark">#00B4FF</Color>
    <Color x:Key="PrimaryDarkText">#F4F7FC</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="SecondaryDarkText">#9880e5</Color>
    <Color x:Key="Tertiary">#2B0B98</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>
    <Color x:Key="CardLight">#F7F8FA</Color>
    <Color x:Key="CardDark">#0D1526</Color>
    <Color x:Key="BadgeLight">#FFFFFF</Color>
    <Color x:Key="BadgeDark">#131E36</Color>

    <!-- ===== Midnight Glass palette (Letterboxd x Backloggd x Persona 3 x PS5) ===== -->
    <!-- Backgrounds / surfaces -->
    <Color x:Key="XmbBackground">#060A14</Color>      <!-- obsidian -->
    <Color x:Key="XmbSurface">#0D1526</Color>         <!-- level 1: cards -->
    <Color x:Key="XmbSurfaceDeep">#131E36</Color>     <!-- level 2: nested blocks, bars -->
    <Color x:Key="XmbSurfaceHover">#192744</Color>    <!-- active / hover blocks -->
    <Color x:Key="XmbBorder">#22345A</Color>          <!-- thin glass outline -->

    <!-- Accents -->
    <Color x:Key="XmbAccent">#00B4FF</Color>          <!-- PlayStation cyan -->
    <Color x:Key="XmbViolet">#7C4DFF</Color>          <!-- electric violet: 100% / platinum -->
    <Color x:Key="XmbPrimaryButton">#0072CE</Color>   <!-- primary button fill (white text stays readable) -->

    <!-- Text -->
    <Color x:Key="XmbText">#F4F7FC</Color>
    <Color x:Key="XmbMuted">#94A6C8</Color>
    <Color x:Key="XmbDim">#5E7196</Color>

    <!-- Semantic -->
    <Color x:Key="XmbGold">#FFC83D</Color>
    <Color x:Key="XmbLike">#FF4D79</Color>
    <Color x:Key="XmbDanger">#E53935</Color>
    <Color x:Key="XmbDangerSoft">#FF8A80</Color>

    <!-- Overlays (solid colours with alpha, no gradients) -->
    <Color x:Key="XmbScrim">#CC060A14</Color>
    <Color x:Key="XmbOverlay">#D9060A14</Color>

    <!-- Status colors (same values as StatusColorConverter) -->
    <Color x:Key="StatusCompleted">#00E676</Color>
    <Color x:Key="StatusPlaying">#FF4081</Color>
    <Color x:Key="StatusBacklog">#00B4FF</Color>
    <Color x:Key="StatusAbandoned">#FF5252</Color>

    <!-- ===== Brushes ===== -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <SolidColorBrush x:Key="XmbBackgroundBrush" Color="{StaticResource XmbBackground}"/>
    <SolidColorBrush x:Key="XmbSurfaceBrush" Color="{StaticResource XmbSurface}"/>
    <SolidColorBrush x:Key="XmbSurfaceDeepBrush" Color="{StaticResource XmbSurfaceDeep}"/>
    <SolidColorBrush x:Key="XmbSurfaceHoverBrush" Color="{StaticResource XmbSurfaceHover}"/>
    <SolidColorBrush x:Key="XmbBorderBrush" Color="{StaticResource XmbBorder}"/>
    <SolidColorBrush x:Key="XmbAccentBrush" Color="{StaticResource XmbAccent}"/>
    <SolidColorBrush x:Key="XmbVioletBrush" Color="{StaticResource XmbViolet}"/>
    <SolidColorBrush x:Key="XmbGoldBrush" Color="{StaticResource XmbGold}"/>
    <SolidColorBrush x:Key="XmbDangerBrush" Color="{StaticResource XmbDanger}"/>
    <SolidColorBrush x:Key="XmbOverlayBrush" Color="{StaticResource XmbOverlay}"/>
</ResourceDictionary>