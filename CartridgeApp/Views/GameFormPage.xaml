<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CartridgeApp.ViewModels"
             x:Class="CartridgeApp.Views.GameFormPage"
             x:DataType="viewmodels:GameFormViewModel"
             Title="Game details">

    <ScrollView BackgroundColor="#060D1F">
        <VerticalStackLayout Padding="20" Spacing="14">
            <Entry Placeholder="Назва гри" Text="{Binding Title}" />
            <Entry Placeholder="Розробник" Text="{Binding Developer}" />

            <Label Text="Платформа" />
            <Picker ItemsSource="{Binding Platforms}" SelectedItem="{Binding Platform}" />

            <Label Text="Статус" />
            <Picker ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" />

            <HorizontalStackLayout Spacing="12">
                <Label Text="Рейтинг" VerticalOptions="Center" />
                <Stepper Minimum="0" Maximum="10" Increment="1"
                         Value="{Binding Rating}" />
                <Label Text="{Binding Rating}" FontAttributes="Bold" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="12">
                <Label Text="Години" VerticalOptions="Center" />
                <Stepper Minimum="0" Maximum="10000" Increment="1"
                         Value="{Binding HoursPlayed}" />
                <Label Text="{Binding HoursPlayed}" FontAttributes="Bold" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Editor Placeholder="Нотатки" Text="{Binding Notes}" AutoSize="TextChanges"
                    HeightRequest="140" />

            <Button Text="Зберегти" Command="{Binding SaveGameCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
