<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CartridgeApp.ViewModels"
             xmlns:models="clr-namespace:CartridgeApp.Models"
             xmlns:converters="clr-namespace:CartridgeApp.Converters"
             xmlns:views="clr-namespace:CartridgeApp.Views"
             x:Class="CartridgeApp.Views.ProfilePage"
             x:DataType="viewmodels:ProfileViewModel"
             Title="Profile"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource XmbBackground}">

    <ContentPage.Resources>
        <converters:StatusColorConverter x:Key="StatusColorConverter" />
        <converters:RatingToStarsConverter x:Key="RatingToStarsConverter" />
        <converters:BoolSwitchConverter x:Key="BoolSwitchConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <views:AppHeader Grid.Row="0" ActiveTab="Profile" />

        <ScrollView Grid.Row="1" BackgroundColor="{StaticResource XmbBackground}">
            <Grid MaximumWidthRequest="1480"
                  HorizontalOptions="Fill"
                  Padding="32,20">
                <Grid IsVisible="{Binding IsProfileView}"
                      ColumnDefinitions="300,*"
                      ColumnSpacing="28">

                <VerticalStackLayout Grid.Column="0" Spacing="16">
                    <Grid ColumnDefinitions="102,*" ColumnSpacing="14">
                        <Grid Grid.Column="0"
                              WidthRequest="102"
                              HeightRequest="102"
                              HorizontalOptions="Center"
                              VerticalOptions="Center">
                            <Ellipse WidthRequest="96"
                                     HeightRequest="96"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Fill="{StaticResource XmbAvatarFill}"
                                     Stroke="{StaticResource XmbAccentBrush}"
                                     StrokeThickness="2" />
                            <Label Text="{Binding Initials}"
                                   FontSize="30"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   TextColor="{StaticResource XmbAccent}" />
                            <Image WidthRequest="96"
                                   HeightRequest="96"
                                   Aspect="AspectFill"
                                   ZIndex="1"
                                   Source="{Binding AvatarSource}"
                                   IsVisible="{Binding HasAvatar}">
                                <Image.Clip>
                                    <EllipseGeometry Center="48,48" RadiusX="48" RadiusY="48" />
                                </Image.Clip>
                            </Image>
                        </Grid>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding DisplayName}"
                                   FontSize="21"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{StaticResource XmbText}" />
                            <Label Text="{Binding Handle}"
                                   FontSize="13"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{StaticResource XmbAccent}" />
                            <Label Text="{Binding FavoritePlatform, StringFormat='🎮 {0}'}"
                                   FontSize="11"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{StaticResource XmbMuted}" />
                            <Border StrokeShape="RoundRectangle 6"
                                    Stroke="{StaticResource XmbVioletBrush}"
                                    StrokeThickness="1"
                                    Background="{StaticResource XmbSurfaceDeepBrush}"
                                    Padding="6,2"
                                    HorizontalOptions="Start">
                                <Label Text="{Binding RankTitle, StringFormat='🏅 {0}'}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource XmbViolet}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Button Text="✎  Edit Profile"
                            HorizontalOptions="Fill"
                            Command="{Binding ToggleEditProfileCommand}"
                            Style="{StaticResource GhostButton}" />

                    <VerticalStackLayout Spacing="8">
                        <Label Text="BIO" Style="{StaticResource SectionTitle}" />
                        <Label Text="{Binding Bio}"
                               IsVisible="{Binding HasBio}"
                               FontSize="13"
                               LineBreakMode="WordWrap"
                               TextColor="{StaticResource XmbMuted}" />
                        <Label Text="Add a short bio to your profile."
                               IsVisible="{Binding HasNoBio}"
                               FontSize="13"
                               TextColor="{StaticResource XmbDim}" />
                        <BoxView HeightRequest="1" Color="{StaticResource XmbSurfaceHover}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="PERSONAL RATINGS"
                                   Style="{StaticResource SectionTitle}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding AverageRatingText}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource XmbGold}" />
                        </Grid>
                        <Label Text="0.5★ – 5.0★"
                               FontSize="10"
                               TextColor="{StaticResource XmbDim}" />
                        <Grid ColumnDefinitions="*,*,*,*,*,*,*,*,*,*"
                              ColumnSpacing="3"
                              HorizontalOptions="Fill"
                              HeightRequest="100"
                              BindableLayout.ItemsSource="{Binding RatingBuckets}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:RatingBucket">
                                    <VerticalStackLayout Grid.Column="{Binding GridColumn}"
                                                         VerticalOptions="End"
                                                         HorizontalOptions="Fill"
                                                         Spacing="3">
                                        <Label Text="{Binding CountText}"
                                               FontSize="8"
                                               HorizontalTextAlignment="Center"
                                               TextColor="{StaticResource XmbMuted}" />
                                        <Border WidthRequest="12"
                                                HeightRequest="{Binding BarHeight}"
                                                HorizontalOptions="Center"
                                                StrokeShape="RoundRectangle 6"
                                                StrokeThickness="0"
                                                Background="{StaticResource XmbAccentBrush}" />
                                        <Label Text="{Binding Label}"
                                               FontSize="7"
                                               HorizontalTextAlignment="Center"
                                               TextColor="{StaticResource XmbDim}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>
                        <Label Text="{Binding RatedGamesText}"
                               FontSize="10"
                               TextColor="{StaticResource XmbDim}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="EARNED BADGES" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto,Auto"
                              ColumnSpacing="10"
                              RowSpacing="10"
                              BindableLayout.ItemsSource="{Binding Badges}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:AchievementBadge">
                                    <Border Grid.Column="{Binding GridColumn}"
                                            Grid.Row="{Binding GridRow}"
                                            StrokeShape="RoundRectangle 12"
                                            Stroke="{Binding AccentColor}"
                                            StrokeThickness="1"
                                            Background="{StaticResource XmbSurfaceBrush}"
                                            Padding="10">
                                        <VerticalStackLayout Spacing="5">
                                            <Label Text="{Binding Icon}"
                                                   FontSize="19"
                                                   TextColor="{Binding AccentColor}" />
                                            <Label Text="{Binding Title}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   MaxLines="2"
                                                   TextColor="{Binding AccentColor}" />
                                            <Label Text="{Binding Description}"
                                                   FontSize="9"
                                                   MaxLines="2"
                                                   TextColor="{StaticResource XmbMuted}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="22">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="FAVORITE GAMES SHOWCASE" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnDefinitions="*,*,*,*"
                              ColumnSpacing="14"
                              HorizontalOptions="Fill"
                              BindableLayout.ItemsSource="{Binding Showcase}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:ShowcaseSlot">
                                    <Grid Grid.Column="{Binding Index}"
                                          RowDefinitions="24,310"
                                          RowSpacing="0"
                                          HorizontalOptions="Fill">
                                        <Label Grid.Row="0"
                                               Text="👑"
                                               FontSize="16"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               TextColor="{StaticResource XmbGold}"
                                               IsVisible="{Binding IsCrowned}" />
                                        <Border Grid.Row="1"
                                                HeightRequest="310"
                                                HorizontalOptions="Fill"
                                                StrokeShape="RoundRectangle 12"
                                                Stroke="{StaticResource XmbSurfaceHoverBrush}"
                                                StrokeThickness="1"
                                                BackgroundColor="#11192B"
                                                Padding="0">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProfileViewModel}}, Path=OpenShowcaseGameCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Grid>
                                                <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                                                     HorizontalOptions="Center"
                                                                     VerticalOptions="Center"
                                                                     Spacing="8">
                                                    <Label Text="+"
                                                           FontSize="32"
                                                           HorizontalTextAlignment="Center"
                                                           TextColor="{StaticResource XmbMuted}" />
                                                    <Label Text="Empty slot"
                                                           FontSize="12"
                                                           TextColor="{StaticResource XmbMuted}" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout IsVisible="{Binding HasGameWithoutCover}"
                                                                     HorizontalOptions="Center"
                                                                     VerticalOptions="Center"
                                                                     Padding="16"
                                                                     Spacing="8">
                                                    <Label Text="{Binding Title}"
                                                           FontSize="16"
                                                           FontAttributes="Bold"
                                                           HorizontalTextAlignment="Center"
                                                           TextColor="{StaticResource XmbText}" />
                                                    <Label Text="{Binding Platform}"
                                                           FontSize="11"
                                                           HorizontalTextAlignment="Center"
                                                           TextColor="{StaticResource XmbMuted}" />
                                                </VerticalStackLayout>
                                                <Image Aspect="AspectFill"
                                                       HorizontalOptions="Fill"
                                                       VerticalOptions="Fill"
                                                       ZIndex="1"
                                                       Source="{Binding CoverUrl}"
                                                       IsVisible="{Binding HasCover}" />
                                                <Border IsVisible="{Binding IsCrowned}"
                                                        InputTransparent="True"
                                                        StrokeShape="RoundRectangle 12"
                                                        Stroke="{StaticResource XmbGoldBrush}"
                                                        StrokeThickness="2"
                                                        BackgroundColor="Transparent"
                                                        Padding="0" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="PLAYER STATS"
                                   Style="{StaticResource SectionTitle}"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="1"
                                    Text="ⓘ"
                                    Style="{StaticResource QuickActionButton}"
                                    Command="{Binding ShowKpiInfoCommand}"
                                    ToolTipProperties.Text="How stats are calculated" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource XmbSurfaceHover}" />
                        <Grid ColumnDefinitions="*,*,*,*,*,*"
                              ColumnSpacing="12"
                              HorizontalOptions="Fill"
                              Padding="0,10">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{Binding TotalLibraryText}" FontSize="27" FontAttributes="Bold" TextColor="{StaticResource XmbText}" />
                                <Label Text="TOTAL" Style="{StaticResource SectionLabel}" FontSize="9" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding PlayedText}" FontSize="27" FontAttributes="Bold" TextColor="{StaticResource StatusPlayed}" />
                                <Label Text="PLAYED" Style="{StaticResource SectionLabel}" FontSize="9" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="4">
                                <Label Text="{Binding CompletedText}" FontSize="27" FontAttributes="Bold" TextColor="{StaticResource StatusCompleted}" />
                                <Label Text="COMPLETED" Style="{StaticResource SectionLabel}" FontSize="8" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="3" Spacing="4">
                                <Label Text="{Binding MasteredText}" FontSize="27" FontAttributes="Bold" TextColor="{StaticResource XmbViolet}" />
                                <Label Text="100%" Style="{StaticResource SectionLabel}" FontSize="9" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="4" Spacing="4">
                                <Label Text="{Binding AbandonedText}" FontSize="27" FontAttributes="Bold" TextColor="{StaticResource StatusAbandoned}" />
                                <Label Text="ABANDONED" Style="{StaticResource SectionLabel}" FontSize="8" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="5" Spacing="4">
                                <Label Text="{Binding HoursLoggedText}" FontSize="27" FontAttributes="Bold" TextColor="{StaticResource XmbAccent}" />
                                <Label Text="HOURS" Style="{StaticResource SectionLabel}" FontSize="9" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource XmbSurfaceHover}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="RECENTLY PLAYED" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnDefinitions="*,*,*,*"
                              ColumnSpacing="16"
                              HorizontalOptions="Fill"
                              BindableLayout.ItemsSource="{Binding RecentLogs}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:RecentPlay">
                                    <VerticalStackLayout Grid.Column="{Binding GridColumn}"
                                                         HorizontalOptions="Fill"
                                                         Spacing="6">
                                        <Border HeightRequest="230"
                                                StrokeShape="RoundRectangle 10"
                                                Stroke="{StaticResource XmbSurfaceDeepBrush}"
                                                StrokeThickness="1"
                                                Background="{StaticResource XmbSurfaceBrush}"
                                                Padding="0">
                                            <Grid>
                                                <Label Text="💿"
                                                       FontSize="32"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                                <Image Aspect="AspectFill"
                                                       Source="{Binding Game.CoverUrl}"
                                                       IsVisible="{Binding Game.HasCover}" />
                                            </Grid>
                                        </Border>
                                        <Label Text="{Binding Game.Title}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               MaxLines="1"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{StaticResource XmbText}" />
                                        <Label Text="{Binding LoggedDate, StringFormat='{0:dd MMM yyyy}'}"
                                               FontSize="10"
                                               TextColor="{StaticResource XmbMuted}" />
                                        <Label Text="{Binding Rating, Converter={StaticResource RatingToStarsConverter}}"
                                               FontSize="10"
                                               TextColor="{StaticResource XmbGold}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>
                        <Label Text="No play sessions logged yet."
                               IsVisible="{Binding HasNoRecentLogs}"
                               FontSize="12"
                               TextColor="{StaticResource XmbDim}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="RECENT DIARY ACTIVITY"
                                   Style="{StaticResource SectionTitle}"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="1"
                                    Text="Open Journal →"
                                    Command="{Binding OpenJournalCommand}"
                                    Style="{StaticResource GhostButton}" />
                        </Grid>
                        <Label Text="No reviews in your diary yet."
                               IsVisible="{Binding HasNoRecentReviews}"
                               FontSize="12"
                               TextColor="{StaticResource XmbDim}" />
                        <VerticalStackLayout Spacing="10"
                                             HorizontalOptions="Fill"
                                             BindableLayout.ItemsSource="{Binding RecentReviews}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:PlayLog">
                                    <Border HorizontalOptions="Fill"
                                            StrokeShape="RoundRectangle 12"
                                            Stroke="{StaticResource XmbSurfaceDeepBrush}"
                                            StrokeThickness="1"
                                            Background="{StaticResource XmbSurfaceBrush}"
                                            Padding="12">
                                        <Grid ColumnDefinitions="64,*" ColumnSpacing="14">
                                            <Border Grid.Column="0"
                                                    WidthRequest="64"
                                                    HeightRequest="92"
                                                    StrokeShape="RoundRectangle 8"
                                                    StrokeThickness="0"
                                                    Background="{StaticResource XmbSurfaceDeepBrush}"
                                                    Padding="0">
                                                <Grid>
                                                    <Label Text="💿"
                                                           FontSize="22"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                    <Image Aspect="AspectFill"
                                                           Source="{Binding Game.CoverUrl}"
                                                           IsVisible="{Binding Game.HasCover}" />
                                                </Grid>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding Game.Title}"
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           LineBreakMode="TailTruncation"
                                                           TextColor="{StaticResource XmbText}" />
                                                    <Label Grid.Column="1"
                                                           Text="{Binding LoggedDate, StringFormat='{0:dd.MM.yyyy}'}"
                                                           FontSize="10"
                                                           TextColor="{StaticResource XmbMuted}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="10">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding Game.Rating, Converter={StaticResource RatingToStarsConverter}}"
                                                           FontSize="11"
                                                           TextColor="{StaticResource XmbGold}" />
                                                    <Label Grid.Column="1"
                                                           Text="{Binding StatusAfterSession}"
                                                           FontSize="10"
                                                           TextTransform="Uppercase"
                                                           TextColor="{Binding StatusAfterSession, Converter={StaticResource StatusColorConverter}}" />
                                                    <Label Grid.Column="2"
                                                           Text="{Binding HoursSession, StringFormat='{}{0:0.#} h'}"
                                                           FontSize="10"
                                                           TextColor="{StaticResource XmbMuted}" />
                                                    <Label Grid.Column="3"
                                                           Text="REPLAY"
                                                           IsVisible="{Binding IsReplay}"
                                                           FontSize="9"
                                                           FontAttributes="Bold"
                                                           HorizontalTextAlignment="End"
                                                           TextColor="{StaticResource XmbViolet}" />
                                                </Grid>
                                                <Label Text="{Binding ReviewText}"
                                                       FontSize="12"
                                                       MaxLines="2"
                                                       LineBreakMode="TailTruncation"
                                                       TextColor="{StaticResource XmbMuted}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout IsVisible="{Binding IsEditing}" Spacing="20">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="EDIT PROFILE" Style="{StaticResource SectionTitle}" />
                            <Label Text="Personalize your profile and favorite games."
                                   FontSize="13"
                                   TextColor="{StaticResource XmbMuted}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="← Back to profile"
                                Command="{Binding CancelEditCommand}"
                                Style="{StaticResource GhostButton}" />
                    </Grid>

                    <Border StrokeShape="RoundRectangle 16"
                            Stroke="{StaticResource XmbSurfaceHoverBrush}"
                            StrokeThickness="1"
                            Background="{StaticResource XmbSurfaceBrush}"
                            Padding="24">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                            <VerticalStackLayout Grid.Column="0" Spacing="12">
                                <Label Text="DISPLAY NAME" Style="{StaticResource SectionLabel}" />
                                <Border StrokeShape="RoundRectangle 10"
                                        Stroke="{StaticResource XmbInputBorderBrush}"
                                        StrokeThickness="1"
                                        BackgroundColor="#141D30"
                                        Padding="14,8">
                                    <Entry Placeholder="Player One"
                                           Text="{Binding EditDisplayName}"
                                           MaxLength="100"
                                           BackgroundColor="Transparent" />
                                </Border>

                                <Label Text="USERNAME / HANDLE" Style="{StaticResource SectionLabel}" />
                                <Border StrokeShape="RoundRectangle 10"
                                        Stroke="{StaticResource XmbInputBorderBrush}"
                                        StrokeThickness="1"
                                        BackgroundColor="#141D30"
                                        Padding="14,8">
                                    <Entry Placeholder="@eveque"
                                           Text="{Binding EditHandle}"
                                           MaxLength="59"
                                           BackgroundColor="Transparent" />
                                </Border>

                                <Grid ColumnDefinitions="82,*" ColumnSpacing="14">
                                    <Grid Grid.Column="0"
                                          WidthRequest="82"
                                          HeightRequest="82"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center">
                                        <Ellipse WidthRequest="76"
                                                 HeightRequest="76"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center"
                                                 Fill="{StaticResource XmbAvatarFill}"
                                                 Stroke="{StaticResource XmbAccentBrush}"
                                                 StrokeThickness="2" />
                                        <Label Text="{Binding EditInitials}"
                                               FontSize="25"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               TextColor="{StaticResource XmbAccent}" />
                                        <Image WidthRequest="76"
                                               HeightRequest="76"
                                               Aspect="AspectFill"
                                               ZIndex="1"
                                               Source="{Binding EditAvatarSource}"
                                               IsVisible="{Binding HasEditAvatar}">
                                            <Image.Clip>
                                                <EllipseGeometry Center="38,38" RadiusX="38" RadiusY="38" />
                                            </Image.Clip>
                                        </Image>
                                    </Grid>
                                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                                        <Label Text="AVATAR URL" Style="{StaticResource SectionLabel}" />
                                        <Border StrokeShape="RoundRectangle 10"
                                                Stroke="{StaticResource XmbInputBorderBrush}"
                                                StrokeThickness="1"
                                                BackgroundColor="#141D30"
                                                Padding="14,8">
                                            <Entry Placeholder="Direct image URL or blank for initials"
                                                   Text="{Binding EditAvatarUrl}"
                                                   Keyboard="Url"
                                                   BackgroundColor="Transparent" />
                                        </Border>
                                        <Button Text="Choose from gallery"
                                                Command="{Binding ChooseAvatarCommand}"
                                                Style="{StaticResource GhostButton}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="12">
                                <Label Text="FAVORITE PLATFORMS" Style="{StaticResource SectionLabel}" />
                                <Border StrokeShape="RoundRectangle 10"
                                        Stroke="{StaticResource XmbInputBorderBrush}"
                                        StrokeThickness="1"
                                        BackgroundColor="#141D30"
                                        Padding="14,8">
                                    <Entry Placeholder="PC / PS2 / PS5"
                                           Text="{Binding EditFavoritePlatform}"
                                           MaxLength="100"
                                           BackgroundColor="Transparent" />
                                </Border>

                                <Label Text="BIOGRAPHY" Style="{StaticResource SectionLabel}" />
                                <Border StrokeShape="RoundRectangle 10"
                                        Stroke="{StaticResource XmbInputBorderBrush}"
                                        StrokeThickness="1"
                                        BackgroundColor="#141D30"
                                        Padding="14,8">
                                    <Editor Placeholder="A few words about your gaming journey…"
                                            Text="{Binding EditBio}"
                                            MaxLength="1000"
                                            AutoSize="TextChanges"
                                            HeightRequest="130"
                                            BackgroundColor="Transparent" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="FAVORITE GAMES &amp; #1 ALL-TIME FAVORITE"
                               Style="{StaticResource SectionTitle}" />
                        <Grid ColumnDefinitions="*,*,*,*"
                              ColumnSpacing="16"
                              HorizontalOptions="Fill"
                              BindableLayout.ItemsSource="{Binding Showcase}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:ShowcaseSlot">
                                    <Grid Grid.Column="{Binding Index}"
                                          RowDefinitions="24,310,Auto"
                                          RowSpacing="8"
                                          HorizontalOptions="Fill">
                                        <Label Grid.Row="0"
                                               Text="👑 #1 FAVORITE"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               CharacterSpacing="1"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               TextColor="{StaticResource XmbGold}"
                                               IsVisible="{Binding IsCrowned}" />
                                        <Border Grid.Row="1"
                                                HeightRequest="310"
                                                HorizontalOptions="Fill"
                                                StrokeShape="RoundRectangle 12"
                                                Stroke="{StaticResource XmbSurfaceHoverBrush}"
                                                StrokeThickness="1"
                                                BackgroundColor="#11192B"
                                                Padding="0">
                                            <Grid>
                                                <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                                                     HorizontalOptions="Center"
                                                                     VerticalOptions="Center"
                                                                     Spacing="8">
                                                    <Label Text="+"
                                                           FontSize="32"
                                                           HorizontalTextAlignment="Center"
                                                           TextColor="{StaticResource XmbMuted}" />
                                                    <Label Text="Empty slot"
                                                           FontSize="12"
                                                           TextColor="{StaticResource XmbMuted}" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout IsVisible="{Binding HasGameWithoutCover}"
                                                                     HorizontalOptions="Center"
                                                                     VerticalOptions="Center"
                                                                     Padding="16"
                                                                     Spacing="8">
                                                    <Label Text="{Binding Title}"
                                                           FontSize="16"
                                                           FontAttributes="Bold"
                                                           HorizontalTextAlignment="Center"
                                                           TextColor="{StaticResource XmbText}" />
                                                    <Label Text="{Binding Platform}"
                                                           FontSize="11"
                                                           HorizontalTextAlignment="Center"
                                                           TextColor="{StaticResource XmbMuted}" />
                                                </VerticalStackLayout>
                                                <Image Aspect="AspectFill"
                                                       HorizontalOptions="Fill"
                                                       VerticalOptions="Fill"
                                                       ZIndex="1"
                                                       Source="{Binding CoverUrl}"
                                                       IsVisible="{Binding HasCover}" />
                                                <Border IsVisible="{Binding IsCrowned}"
                                                        InputTransparent="True"
                                                        StrokeShape="RoundRectangle 12"
                                                        Stroke="{StaticResource XmbGoldBrush}"
                                                        StrokeThickness="2"
                                                        BackgroundColor="Transparent"
                                                        Padding="0" />
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <Button Grid.Column="0"
                                                    Text="👑 #1"
                                                    Style="{StaticResource QuickActionButton}"
                                                    BackgroundColor="{Binding IsCrowned, Converter={StaticResource BoolSwitchConverter}, ConverterParameter='XmbGold|XmbSurfaceDeep'}"
                                                    TextColor="{Binding IsCrowned, Converter={StaticResource BoolSwitchConverter}, ConverterParameter='XmbBackground|XmbMuted'}"
                                                    IsEnabled="{Binding HasGame}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProfileViewModel}}, Path=CrownShowcaseGameCommand}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Grid.Column="1"
                                                    Text="⇄ Change"
                                                    Style="{StaticResource QuickActionButton}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProfileViewModel}}, Path=SelectShowcaseGameCommand}"
                                                    CommandParameter="{Binding Index}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                        <Button Grid.Column="1"
                                Text="Cancel"
                                Command="{Binding CancelEditCommand}"
                                Style="{StaticResource GhostButton}" />
                        <Button Grid.Column="2"
                                Text="Save Changes"
                                Command="{Binding SaveProfileCommand}"
                                Style="{StaticResource SpinButton}" />
                    </Grid>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
