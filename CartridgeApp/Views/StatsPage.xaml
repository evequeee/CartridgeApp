<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CartridgeApp.ViewModels"
             x:Class="CartridgeApp.Views.StatsPage"
             x:DataType="viewmodels:StatsViewModel"
             Title="Statistics">

    <ContentPage.Resources>
        <LinearGradientBrush x:Key="StatsBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#050A18" Offset="0" /><GradientStop Color="#0B1B3A" Offset="0.55" /><GradientStop Color="#040812" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Resources>

    <Grid Background="{StaticResource StatsBackground}">
        <ScrollView>
            <VerticalStackLayout MaximumWidthRequest="1100" Padding="20" Spacing="14">
            <Label Text="BACKLOG // ANALYTICS" FontSize="28" FontAttributes="Bold" TextColor="#F3F7FF" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                <Border Grid.Row="0" Grid.Column="0" Padding="14" Stroke="#264785" StrokeThickness="1" StrokeShape="RoundRectangle 10"><Border.Background><SolidColorBrush Color="#101D38" /></Border.Background><VerticalStackLayout>
                    <Label Text="TOTAL GAMES" FontSize="11" TextColor="#8FA6CC" /><Label Text="{Binding TotalGames}" FontSize="24" FontAttributes="Bold" TextColor="#F3F7FF" />
                </VerticalStackLayout></Border>
                <Border Grid.Row="0" Grid.Column="1" Padding="14" Stroke="#264785" StrokeThickness="1" StrokeShape="RoundRectangle 10"><Border.Background><SolidColorBrush Color="#101D38" /></Border.Background><VerticalStackLayout>
                    <Label Text="FAVORITES" FontSize="11" TextColor="#8FA6CC" /><Label Text="{Binding FavoriteGames}" FontSize="24" FontAttributes="Bold" TextColor="#FFD54F" />
                </VerticalStackLayout></Border>
                <Border Grid.Row="1" Grid.Column="0" Padding="14" Stroke="#264785" StrokeThickness="1" StrokeShape="RoundRectangle 10"><Border.Background><SolidColorBrush Color="#101D38" /></Border.Background><VerticalStackLayout>
                    <Label Text="HOURS PLAYED" FontSize="11" TextColor="#8FA6CC" /><Label Text="{Binding TotalHoursPlayed}" FontSize="24" FontAttributes="Bold" TextColor="#00A8FF" />
                </VerticalStackLayout></Border>
                <Border Grid.Row="1" Grid.Column="1" Padding="14" Stroke="#264785" StrokeThickness="1" StrokeShape="RoundRectangle 10"><Border.Background><SolidColorBrush Color="#101D38" /></Border.Background><VerticalStackLayout>
                    <Label Text="COMPLETED" FontSize="11" TextColor="#8FA6CC" /><Label Text="{Binding CompletedPercentage, StringFormat='{0:F1}%'}" FontSize="24" FontAttributes="Bold" TextColor="#00E676" />
                </VerticalStackLayout></Border>
            </Grid>

            <Label Text="Загальний прогрес проходження" FontAttributes="Bold" />
            <ProgressBar Progress="{Binding CompletedProgress}" ProgressColor="#00A8FF" HeightRequest="8" />

            <Label Text="Data Backup &amp; Restore" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0" Text="Експорт JSON" Command="{Binding ExportBackupCommand}" />
                <Button Grid.Column="1" Text="Імпорт JSON" Command="{Binding ImportBackupCommand}" />
            </Grid>

            <Label Text="Ігри за платформами" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding PlatformStats}" HeightRequest="220">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" ColumnDefinitions="*,Auto">
                            <Label Text="{Binding Key}" Grid.Column="0" />
                            <Label Text="{Binding Value}" Grid.Column="1" FontAttributes="Bold" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
